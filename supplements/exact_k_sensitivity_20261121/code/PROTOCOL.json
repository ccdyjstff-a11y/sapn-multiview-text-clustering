      "state_checks.nonnegative_where_required",
      "state_checks.all_membership_rows_positive"
    ],
    "required_zero": [
      "initial_CL_nonzeros: one finite zero per view",
      "final_CL_max_abs"
    ],
    "removed_only": [
      "strict_c: sample_partition_count==c",
      "diagnostics.operational_contract: actual_clusters==NC"
    ],
    "operational_reconstruction": "numeric_outputs_finite includes finite objective; all_finite and nonnegative state checks cover finite_nonnegative_state; reconstruct exact initial/final CL zero-lock without requiring the k-contaminated operational_contract boolean.",
    "diagnostics_not_added_as_gates": [
      "row-sum residuals",
      "W orthogonality",
      "Theta normalization",
      "stationarity",
      "native finite iteration cap"
