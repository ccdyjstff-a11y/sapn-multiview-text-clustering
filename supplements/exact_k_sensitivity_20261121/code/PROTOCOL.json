  "paired_difference": "baseline minus original SAPN-MV",
  "group_summary": "For each metric, report mean and sample SD only for all three planned, non-k-qualified pairs with that metric available on both sides; never available-case means. Pair qualification itself does not use metric values.",
  "admission_categories": [
    "strict_eligible",
    "finite_wrong_k"
  ],
  "other_categories_retained_but_excluded": true,
  "missing_or_unknown_metadata": "Exclude from this sensitivity with explicit reason; never infer success from category alone. Changed evidence hashes abort the analysis.",
