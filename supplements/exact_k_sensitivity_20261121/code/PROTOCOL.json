  "numeric_metadata": "Required numeric contract fields must be finite JSON numbers, not bool/null/NaN/inf. Count fields must be integral.",
  "SSA": {
    "required_true": [
      "execution_returned",
      "finite_partition_retained",
      "numeric_outputs_finite",
